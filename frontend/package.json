{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "node --test test/*test.js",
    "test:rules": "node --test test/rules.emulator.mjs",
    "test:rules:emulator": "cd .. && npx --yes firebase-tools emulators:exec --only firestore --project demo-money-manager \"npm --prefix frontend run test:rules\"",
    "verify": "npm test && npm run lint && npm run build",
    "verify:full": "npm run verify && npm run test:browser",
    "deploy:preview": "npm run verify:full && npx firebase-tools hosting:channel:deploy preview --expires 7d",
    "deploy:live": "npm run verify:full && npx firebase-tools deploy --only firestore:rules,hosting",
    "dev:test": "vite --config vite.browser.config.js",
    "test:browser": "playwright test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
