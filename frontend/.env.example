# Copy to frontend/.env and fill in from Firebase console →
# Project settings → General → Your apps → Web app → SDK setup (Config).
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Optional: Firebase App Check (recommended for production).
# Firebase console → App Check → Apps → your web app → reCAPTCHA v3 → site key.
VITE_APPCHECK_SITE_KEY=
# Optional, dev only: a registered App Check debug token (otherwise one is
# generated and printed in the browser console the first time).
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: one-tap backup to Google Drive (Settings → Backup).
# Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (Web application), authorised JavaScript origins = your site + localhost.
# Enable the Google Drive API for the project. Scope used: drive.file.
VITE_GOOGLE_CLIENT_ID=
